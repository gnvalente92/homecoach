{
  "uid": "homecoach-overview",
  "title": "homecoach overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Weekly running km",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homecoach-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homecoach-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('week', local_date)::timestamp AS time, round(sum(distance_m)/1000.0,1) AS km FROM activities WHERE type='Run' AND $__timeFilter(local_date::timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Resting HR & HRV",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homecoach-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homecoach-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, resting_hr AS \"resting HR\", hrv_avg AS HRV FROM daily_metrics WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Steps",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homecoach-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homecoach-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, steps FROM daily_metrics WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Training load",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homecoach-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homecoach-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, load_short AS short, load_long AS long, load_ratio AS ratio FROM daily_metrics WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sleep (hours)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homecoach-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homecoach-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, round(sleep_min/60.0,2) AS sleep, round(deep_min/60.0,2) AS deep, round(rem_min/60.0,2) AS rem FROM daily_metrics WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Run pace (min/km) vs HR",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homecoach-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homecoach-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT start_time AS time, round((duration_s/(distance_m/1000.0))/60.0,2) AS pace, avg_hr FROM activities WHERE type='Run' AND distance_m>0 AND $__timeFilter(start_time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Activities",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homecoach-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homecoach-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT local_date AS date, type, sport, name, round(distance_m/1000.0,2) AS km, duration_s/60 AS minutes, avg_hr FROM activities WHERE $__timeFilter(start_time) ORDER BY start_time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "tags": [
    "homecoach"
  ]
}