# Copy to .env on the NAS (never commit .env). All values below are placeholders.
HC_ATHLETE_NAME=Your Name
HC_TIMEZONE=Europe/Lisbon

# Data source: "coros" (unofficial Training Hub web API) or "none" (FIT folder import only)
HC_PROVIDER=coros
HC_COROS_EMAIL=you@example.com
HC_COROS_PASSWORD=change-me
# eu = teameuapi.coros.com, en = teamapi.coros.com (Americas)
HC_COROS_REGION=eu

# Optional login for the web app (recommended if it is reachable beyond your LAN)
HC_AUTH_USER=
HC_AUTH_PASSWORD=

HC_SYNC_INTERVAL_MINUTES=10
HC_FULL_SYNC_HOUR=3
HC_BACKFILL_DAYS=730

POSTGRES_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=change-me-three

# Host paths (TrueNAS datasets)
HC_DATA_PATH=/mnt/tank/apps/homecoach/data
HC_PG_PATH=/mnt/tank/apps/homecoach/postgres
HC_BACKUP_PATH=/mnt/tank/apps/homecoach/backups
HC_GRAFANA_PATH=/mnt/tank/apps/homecoach/grafana
HC_WEB_PORT=8742
GRAFANA_PORT=3742

# ---- Optional local AI: race assistant + coach (include docker-compose.llm.yml) ----
# openai = any OpenAI-compatible server (the bundled Ollama by default); anthropic = Claude API (paid, needs HC_LLM_API_KEY)
HC_LLM_PROVIDER=none
HC_LLM_BASE_URL=http://ollama:11434/v1
# qwen2.5:3b runs on a modest CPU (~2.5 GB RAM); qwen2.5:7b is smarter but ~2x slower (~5.5 GB RAM)
HC_LLM_MODEL=qwen2.5:3b
HC_LLM_API_KEY=
HC_SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-four
HC_OLLAMA_PATH=/mnt/tank/apps/homecoach/ollama
# Weekly coach review: day (0=Mon..6=Sun) and hour
HC_COACH_REVIEW_DOW=6
HC_COACH_REVIEW_HOUR=19
